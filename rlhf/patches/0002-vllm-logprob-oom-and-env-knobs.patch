 from vllm import LLM
 import os
+import torch
 
 # Set environment variables for better CUDA error handling
 ## NEW
 os.environ["PYTORCH_CUDA_ALLOC_CONF"] = "expandable_segments:True"
 ## NEW
 
+# Model-organism pipeline: found via reading vllm/model_executor/layers/sampler.py directly --
+# get_logprobs() unconditionally calls _get_ranks() (materializes a full [N, vocab_size] logprob
+# tensor PLUS a same-shape boolean comparison tensor) for every prompt query token whenever
+# sampling_params.prompt_logprobs is not None, even when it's 0. This is separate from the
+# top-k computation (torch.topk), which IS correctly gated by `if largest_num_logprobs > 0` --
+# the rank computation is not gated at all. get_prompt_logprobs() below only ever reads
+# `.logprob` off the returned Logprob objects, never `.rank`, so this is pure wasted compute --
+# and its size scales with PROMPT LENGTH x VOCAB SIZE (not batch/chunk size), which is exactly
+# why reducing JUDGE_CHUNK_SIZE never fixed repeated OOMs on long (WildChat-derived) prompts: a
+# single long sequence alone materializes a multi-GB transient tensor here, regardless of how
+# many other sequences share its batch. Monkeypatched out below rather than editing the
+# installed vllm package directly (keeps the fix local/reversible, doesn't survive a vllm
+# version bump silently -- if this ever stops applying cleanly, re-check this function still
+# matches vllm/model_executor/layers/sampler.py's _get_ranks signature/behavior).
+import vllm.model_executor.layers.sampler as _vllm_sampler
+
+
+def _cheap_unused_ranks(x: torch.Tensor, indices: torch.Tensor) -> torch.Tensor:
+    return torch.ones(x.shape[0], dtype=torch.long, device=x.device)
+
+
+_vllm_sampler._get_ranks = _cheap_unused_ranks
+
